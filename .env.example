# Copy this file to .env.local and fill in your key. Never commit real keys.
# Free Groq key: https://console.groq.com/keys
LLM_API_KEY=

# Optional: any OpenAI-compatible endpoint and model
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: Pollinations Personal Secret Key (sk_...) for image generation.
# Create it at https://enter.pollinations.ai/keys with a small Pollen budget. Keep it server-side only.
POLLINATIONS_API_KEY=
