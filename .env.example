# Copy this file to .env.local and fill in your key. Never commit real keys.
# Free Groq key: https://console.groq.com/keys
LLM_API_KEY=

# Optional: any OpenAI-compatible endpoint and model
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: free Pollinations key for image generation (https://enter.pollinations.ai/keys)
POLLINATIONS_API_KEY=
